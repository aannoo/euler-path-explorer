/**
 * CoolTextFit - Prioritizes readability and smooth scaling over pixel perfection
 * "Biggest font that fits" approach for natural, consistent results
 * SINGLE-LINE TEXT ONLY - forces white-space: nowrap
 */
class CoolTextFit {
    constructor(options = {}) {
        this.config = {
            // ═══════════════════════════════════════════════════════════════
            // FONT SIZE CONFIGURATION (Priority #1)
            // ═══════════════════════════════════════════════════════════════
            
            // Font size range in pixels - algorithm starts at max and works down to min
            // • Default: null (uses element's current fontSize for both min and max = no font scaling)
            // • Override both: Set explicit range like { fontSizeMin: 20, fontSizeMax: 120 }
            // • Override one: Mix explicit with null, e.g., { fontSizeMax: 100 } uses current fontSize as min
            // • Container height fitting: Set min/max to container height for perfect vertical fit
            //   Example: const height = container.getBoundingClientRect().height;
            //            CoolTextFit.fit(element, { fontSizeMin: height, fontSizeMax: height });
            fontSizeMin: null, //20
            fontSizeMax: null, //120
            
            // ═══════════════════════════════════════════════════════════════
            // VARIABLE FONT WIDTH (Priority #2)
            // ═══════════════════════════════════════════════════════════════
            
            // Variable font width axis range - controls character width/condensing
            // • Default: null (auto-detects font's actual wdth axis capabilities)
            // • Override: Set explicit values if you know font specs or want to limit range
            // • Requires: Google Fonts with wdth parameter: "Family:wdth,wght@50..150,100..900"
            // • Common ranges: Anybody (50-150), Roboto Flex (25-151), Oswald (75-100)
            // • Performance: Auto-detection runs once per font family, then cached
            // • 100 = normal width, <100 = condensed, >100 = expanded
            fontWidthMin: null, //50
            fontWidthMax: null, //150
            
            // ═══════════════════════════════════════════════════════════════
            // SCALE TRANSFORM (Priority)
            // ═══════════════════════════════════════════════════════════════
            
            // ScaleX transform range - horizontal stretching/compression via CSS transform
            // • Default: 0.9 to 2 (allows 10% compression and 100% stretching)
            // • Hard limit: Algorithm enforces 0.9 minimum regardless of scaleXMin setting
            // • Below 0.9: Considered a failed fit, may trigger fallback behavior
            // • Compression preferred over stretching for better readability
            // • Reaching scaleXMax enables letter spacing as next step
            // • Range guidelines: 0.8-1.2 (subtle), 0.7-1.5 (moderate), 0.6-2.0 (aggressive)
            scaleXMin: 0.9,
            scaleXMax: 2,
            
            // ═══════════════════════════════════════════════════════════════
            // LETTER SPACING (Priority #4)
            // ═══════════════════════════════════════════════════════════════
            
            // Letter spacing range in pixels (minimum is always 0)
            // • Default: 0 to 60px (generous expansion capability)  
            // • Only activates when: scaleX >= scaleXMax AND text is too narrow
            // • Increments: 5px steps for performance (not 1px precision)
            // • Limitation: Only works with multi-character text (length > 1)
            // • Visual impact: Values >30px can make text very spaced out
            // • Use cases: Wide containers with short text, display typography
            letterSpacingMax: 60,
            
            // ═══════════════════════════════════════════════════════════════
            // ⚡ PERFORMANCE & BEHAVIOR
            // ═══════════════════════════════════════════════════════════════
            
            // Font size step increment in pixels - balance between speed and precision
            // • Default: 2px (good balance of performance vs accuracy)
            // • 1px: Highest precision, slower performance
            // • 4px+: Faster but may miss optimal sizes
            // • Algorithm uses adaptive steps: 8px → 4px → 2px based on distance from target
            fontSizeStep: 2,
            
            // Debounce delay in milliseconds for resize events
            // • Default: 100ms (prevents excessive refitting during window resize)
            // • Lower values: More responsive but may cause performance issues
            // • Higher values: Less responsive but smoother resize experience
            // • Set to 0: Disable debouncing (not recommended)
            debounceMs: 100,
            
            // Enable detailed console logging for debugging
            // • Default: false (production mode)
            // • true: Logs algorithm steps, timing, font detection, and results
            // • Useful for: Understanding why fits fail, performance tuning, font debugging
            // • Performance impact: Minimal, but avoid in production
            debug: false,
            
            ...options
        };
        
        this.observers = new Map();
        this.measureEl = this.createMeasureElement();
        
        // Cache font capabilities to avoid re-detection
        this.fontCapabilitiesCache = new Map();
        
        // Track fitting operations to prevent thrashing
        this.fittingElements = new Set();
    }
    
    // Debug logging methods
    log(message, data = {}) {
        if (this.config.debug) {
            console.log(`🔍 CoolTextFit: ${message}`, data);
        }
    }
    
    logFitStart(text, targetWidth) {
        if (this.config.debug) {
            console.log(`🎯 Starting fit for "${text}" in ${targetWidth.toFixed(1)}px container`);
            this.fitStartTime = performance.now();
        }
    }
    
    logFitResult(result) {
        if (this.config.debug) {
            const fitTime = this.fitStartTime ? (performance.now() - this.fitStartTime).toFixed(1) : 'N/A';
            console.log(`📋 Fit result (${fitTime}ms):`, {
                fontSize: result.fontSize,
                fontWidth: result.fontWidth,
                scaleX: result.scaleX.toFixed(2),
                letterSpacing: result.letterSpacing,
                finalWidth: result.finalWidth.toFixed(1),
                fits: result.fits,
                error: result.error.toFixed(1)
            });
        }
    }
    
    logAlgorithmStep(step, details) {
        if (this.config.debug) {
            console.log(`   ${step}:`, details);
        }
    }
    
    logFontCapabilities(fontFamily, capabilities) {
        if (this.config.debug) {
            console.log(`🔤 Font capabilities for ${fontFamily}:`, {
                isVariable: capabilities.isVariableFont,
                widthRange: capabilities.isVariableFont ? `${capabilities.fontWidthMin}-${capabilities.fontWidthMax}` : 'N/A'
            });
        }
    }
    
    createMeasureElement() {
        const el = document.createElement('div');
        el.style.cssText = `
            position: absolute; top: -9999px; visibility: hidden;
            font-family: 'Anybody', sans-serif; font-weight: 700;
            text-transform: uppercase; white-space: nowrap;
        `;
        document.body.appendChild(el);
        return el;
    }
    
    // CORE ALGORITHM: Start big, shrink until it fits
    fit(element, options = {}) {
        if (typeof element === 'string') {
            element = document.querySelector(element);
        }
        
        const config = { ...this.config, ...options };
        const container = element.parentElement || element;
        
        // Extract font properties from the element
        const fontProps = this.extractFontProperties(element);
        
        // Update measurement element to match target element's font
        this.updateMeasureElement(fontProps);
        
        // Get or detect font capabilities (with caching)
        const fontCapabilities = this.getFontCapabilities(fontProps);
        
        // Store for use in measure method
        this.currentFontIsVariable = fontCapabilities.isVariableFont;
        
        // Use element's current fontSize as default if not provided
        if (config.fontSizeMin === null) config.fontSizeMin = fontProps.fontSize;
        if (config.fontSizeMax === null) config.fontSizeMax = fontProps.fontSize;
        
        // Merge font capabilities into config
        const fontConfig = { 
            ...config, 
            ...fontCapabilities,
            fontProps 
        };
        
        this.setupAutoRefit(container, element, fontConfig);
        return this.performFit(element, fontConfig, container);
    }
    
    performFit(element, config, container) {
        // Mark element as being fitted to prevent thrashing
        this.fittingElements.add(element);
        
        const text = element.textContent.toUpperCase();
        const targetWidth = container ? container.getBoundingClientRect().width : 
                           (element.parentElement ? element.parentElement.getBoundingClientRect().width : 0);
        
        if (!text || targetWidth <= 0) {
            this.fittingElements.delete(element);
            return null;
        }
        
        // Debug logging
        this.logFitStart(text, targetWidth);
        
        // Two-pass approach: rough pass with adaptive steps, then precision pass
        let roughFit = this.findRoughFit(text, targetWidth, config);
        if (!roughFit) {
            // Fallback: Use minimum font size
            const fallback = this.tryFontSize(text, config.fontSizeMin, targetWidth, config);
            this.applyResult(element, fallback, config);
            this.logFitResult(fallback);
            this.fittingElements.delete(element);
            return fallback;
        }
        
        // Precision pass: try slightly larger sizes around the rough fit
        const precisionFit = this.refineFit(text, targetWidth, config, roughFit);
        this.applyResult(element, precisionFit, config);
        this.logFitResult(precisionFit);
        
        // Mark fitting as complete
        this.fittingElements.delete(element);
        
        return precisionFit;
    }
    
    // Rough pass with adaptive step sizing
    findRoughFit(text, targetWidth, config) {
        this.logAlgorithmStep('Starting rough fit', { targetWidth });
        
        for (let fontSize = config.fontSizeMax; fontSize >= config.fontSizeMin; fontSize -= this.getAdaptiveStep(fontSize, targetWidth, config)) {
            // Check if this font size CAN fit (without scaleX limits)
            const checkResult = this.tryFontSize(text, fontSize, targetWidth, config, false);
            
            this.logAlgorithmStep(`Trying fontSize ${fontSize}`, { 
                measuredWidth: checkResult.finalWidth.toFixed(1), 
                fits: checkResult.fits 
            });
            
            if (checkResult.fits) {
                // Found a font size that works, now optimize it fully
                this.logAlgorithmStep('Found rough fit', { fontSize });
                return { fontSize, result: this.tryFontSize(text, fontSize, targetWidth, config, true) };
            }
        }
        
        this.logAlgorithmStep('No rough fit found', { fallbackToMinimum: true });
        return null;
    }
    
    // Get adaptive step size based on how far we are from target
    getAdaptiveStep(fontSize, targetWidth, config) {
        // Quick test to estimate how far off we might be
        const testResult = this.tryFontSize("TEST", fontSize, targetWidth, config);
        const errorRatio = testResult.error / targetWidth;
        
        // Use bigger steps when way off, smaller when close
        if (errorRatio > 0.5) return 8;      // Way too big - big steps
        if (errorRatio > 0.2) return 4;      // Moderately off - medium steps  
        return config.fontSizeStep;          // Close - normal steps
    }
    
    // Precision pass: try sizes between rough fit and next step up
    refineFit(text, targetWidth, config, roughFit) {
        const { fontSize: roughSize, result: roughResult } = roughFit;
        
        // Try sizes between roughSize and roughSize + 8 (max step we used)
        for (let fontSize = Math.min(roughSize + 8, config.fontSizeMax); fontSize > roughSize; fontSize -= 1) {
            const result = this.tryFontSize(text, fontSize, targetWidth, config);
            if (result.fits) {
                return result; // Found a better (larger) fit
            }
        }
        
        return roughResult; // Rough fit was best
    }
    
    // Try to make a font size fit using minimal adjustments
    tryFontSize(text, fontSize, targetWidth, config) {
        // Step 1: Try normal font width (100)
        let fontWidth = 100;
        let scaleX = 1;
        let letterSpacing = 0;
        let width = this.measure(text, fontSize, fontWidth, scaleX, letterSpacing);
        
        // Step 2: If font supports variable width, optimize font width
        if (config.isVariableFont && Math.abs(width - targetWidth) > 1) {
            fontWidth = this.findBestWidth(text, fontSize, targetWidth, config);
            width = this.measure(text, fontSize, fontWidth, scaleX, letterSpacing);
            this.log(`Variable width result`, { fontWidth, newWidth: width.toFixed(1) });
        }
        
        // Step 3: Use scaleX to fine-tune
        if (Math.abs(width - targetWidth) > 1) {
            const idealScaleX = targetWidth / width;
            scaleX = Math.max(0.9, Math.min(config.scaleXMax, idealScaleX)); // 0.9 hardcoded minimum per specs
            width = this.measure(text, fontSize, fontWidth, scaleX, letterSpacing);
        }
        
        // Step 4: Letter spacing for final expansion (only when scaleX at max)
        if (width < targetWidth && text.length > 1 && scaleX >= config.scaleXMax - 0.01) {
            for (let spacing = 5; spacing <= config.letterSpacingMax; spacing += 5) { // 5px increments per specs
                const testWidth = this.measure(text, fontSize, fontWidth, scaleX, spacing);
                if (testWidth <= targetWidth) {
                    letterSpacing = spacing;
                } else {
                    break;
                }
            }
            width = this.measure(text, fontSize, fontWidth, scaleX, letterSpacing);
        }
        
        return {
            fontSize,
            fontWidth,
            scaleX,
            letterSpacing,
            finalWidth: width,
            fits: width <= targetWidth + 10 && scaleX >= 0.9, // Allow 10px overflow tolerance, enforce 0.9 minimum per specs
            error: Math.abs(width - targetWidth)
        };
    }
    
    // Simple binary search for font width
    findBestWidth(text, fontSize, targetWidth, config) {
        let left = config.fontWidthMin;
        let right = config.fontWidthMax;
        
        for (let i = 0; i < 10; i++) { // Max 10 iterations
            const mid = Math.round((left + right) / 2);
            const width = this.measure(text, fontSize, mid, 1);
            
            if (width <= targetWidth) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }
        
        const result = Math.round((left + right) / 2);
        // CLAMP to detected bounds
        return Math.max(config.fontWidthMin, Math.min(config.fontWidthMax, result));
    }
    
    measure(text, fontSize, fontWidth, scaleX, letterSpacing = 0) {
        this.measureEl.textContent = text;
        this.measureEl.style.fontSize = fontSize + 'px';
        this.measureEl.style.fontVariationSettings = `"wdth" ${fontWidth}`;
        this.measureEl.style.transform = `scaleX(${scaleX})`;
        this.measureEl.style.letterSpacing = letterSpacing + 'px';
        
        const width = this.measureEl.getBoundingClientRect().width;
        // Always subtract trailing letter-spacing (happens with positive AND negative values)
        return letterSpacing !== 0 ? width - letterSpacing : width;
    }
    
    applyResult(element, result, config) {
        element.style.fontSize = result.fontSize + 'px';
        element.style.fontFamily = config.fontProps.fontFamily;
        element.style.fontWeight = config.fontProps.fontWeight;
        element.style.fontStyle = config.fontProps.fontStyle;
        element.style.transform = `scaleX(${result.scaleX})`;
        element.style.letterSpacing = result.letterSpacing + 'px';
        element.style.transformOrigin = this.getTransformOrigin(config.fontProps.textAlign, config.fontProps.direction);
        element.style.textTransform = config.fontProps.textTransform;
        element.style.whiteSpace = 'nowrap'; // Force single-line
        
        // Only apply variable font settings if supported
        if (config.isVariableFont) {
            element.style.fontVariationSettings = `"wdth" ${result.fontWidth}`;
        }
    }
    
    setupAutoRefit(container, element, config) {
        if (this.observers.has(element)) {
            this.observers.get(element).disconnect();
        }
        
        const observer = new ResizeObserver(entries => {
            // Skip if already fitting this element
            if (this.fittingElements.has(element)) return;
            
            clearTimeout(this.debounceTimer);
            this.debounceTimer = setTimeout(() => {
                this.performFit(element, config, container);
            }, config.debounceMs);
        });
        
        observer.observe(container);
        this.observers.set(element, observer);
    }
    
    // Static API
    static fit(element, options = {}) {
        if (!CoolTextFit._instance) {
            CoolTextFit._instance = new CoolTextFit();
        }
        return CoolTextFit._instance.fit(element, options);
    }
    
    // Clear all caches - useful for development
    clearCache() {
        this.fontCapabilitiesCache.clear();
        this.log('Font capabilities cache cleared');
    }
    
    // Get debugging information for an element
    getDebugInfo(element) {
        if (typeof element === 'string') {
            element = document.querySelector(element);
        }
        
        const computed = window.getComputedStyle(element);
        const rect = element.getBoundingClientRect();
        const containerRect = element.parentElement ? element.parentElement.getBoundingClientRect() : { width: 0, height: 0 };
        
        const fontProps = this.extractFontProperties(element);
        const fontKey = [fontProps.fontFamily, fontProps.fontWeight, fontProps.fontStyle].join('\0');
        const capabilities = this.fontCapabilitiesCache.get(fontKey);
        
        return {
            element: {
                text: element.textContent,
                width: rect.width.toFixed(1),
                height: rect.height.toFixed(1)
            },
            container: {
                width: containerRect.width.toFixed(1),
                height: containerRect.height.toFixed(1)
            },
            styles: {
                fontSize: computed.fontSize,
                fontFamily: computed.fontFamily,
                fontWeight: computed.fontWeight,
                transform: computed.transform,
                letterSpacing: computed.letterSpacing,
                fontVariationSettings: computed.fontVariationSettings
            },
            font: {
                isVariable: capabilities?.isVariableFont || false,
                widthMin: capabilities?.fontWidthMin || null,
                widthMax: capabilities?.fontWidthMax || null
            },
            fit: {
                fits: rect.width <= containerRect.width,
                utilization: ((rect.width / containerRect.width) * 100).toFixed(1) + '%',
                overflow: Math.max(0, rect.width - containerRect.width).toFixed(1)
            }
        };
    }
    
    extractFontProperties(element) {
        const computed = window.getComputedStyle(element);
        return {
            fontFamily: computed.fontFamily,
            fontWeight: computed.fontWeight,
            fontStyle: computed.fontStyle,
            textTransform: computed.textTransform,
            fontSize: parseFloat(computed.fontSize),
            textAlign: computed.textAlign,
            direction: computed.direction
        };
    }
    
    updateMeasureElement(fontProps) {
        this.measureEl.style.fontFamily = fontProps.fontFamily;
        this.measureEl.style.fontWeight = fontProps.fontWeight;
        this.measureEl.style.fontStyle = fontProps.fontStyle;
        this.measureEl.style.textTransform = fontProps.textTransform;
    }
    
    getFontCapabilities(fontProps) {
        // Create cache key with null separator to avoid collisions
        const fontKey = [fontProps.fontFamily, fontProps.fontWeight, fontProps.fontStyle].join('\0');
        
        // Check cache first
        if (this.fontCapabilitiesCache.has(fontKey)) {
            return this.fontCapabilitiesCache.get(fontKey);
        }
        
        // Detect font capabilities
        const capabilities = this.detectFontCapabilities(fontProps);
        
        // Cache the results
        this.fontCapabilitiesCache.set(fontKey, capabilities);
        
        return capabilities;
    }
    
    detectFontCapabilities(fontProps) {
        this.log('Detecting font capabilities', { fontFamily: fontProps.fontFamily });
        
        const testElement = document.createElement('span');
        testElement.style.cssText = `
            position: absolute;
            left: -9999px;
            font-family: ${fontProps.fontFamily};
            font-size: 100px;
            white-space: nowrap;
        `;
        testElement.textContent = 'W';
        document.body.appendChild(testElement);
        
        // Test if variable width is supported
        const normalWidth = testElement.getBoundingClientRect().width;
        
        // Try extreme narrow
        testElement.style.fontVariationSettings = '"wdth" 25';
        const narrowWidth = testElement.getBoundingClientRect().width;
        
        // Try extreme wide  
        testElement.style.fontVariationSettings = '"wdth" 200';
        const wideWidth = testElement.getBoundingClientRect().width;
        
        document.body.removeChild(testElement);
        
        const hasVariableWidth = narrowWidth !== normalWidth || wideWidth !== normalWidth;
        
        this.log('Font width test results', {
            normalWidth: normalWidth.toFixed(1),
            narrowWidth: narrowWidth.toFixed(1), 
            wideWidth: wideWidth.toFixed(1),
            isVariable: hasVariableWidth
        });
        
        let fontWidthMin = null;
        let fontWidthMax = null;
        
        if (hasVariableWidth) {
            // Binary search with proper ranges based on Google Fonts data
            let minRange = [10, 100];    // Most fonts: min 25-100
            let maxRange = [100, 250];   // Most fonts: max 100-200, some to 250
            
            fontWidthMin = this.binarySearchFontWidth(fontProps.fontFamily, normalWidth, minRange, 'min');
            fontWidthMax = this.binarySearchFontWidth(fontProps.fontFamily, normalWidth, maxRange, 'max');
            
            this.log('Detected width range', { min: fontWidthMin, max: fontWidthMax });
        }
        
        const capabilities = {
            isVariableFont: hasVariableWidth,
            fontWidthMin,
            fontWidthMax
        };
        
        this.logFontCapabilities(fontProps.fontFamily, capabilities);
        
        return capabilities;
    }
    
    binarySearchFontWidth(fontFamily, baseWidth, range, type) {
        let left = range[0];
        let right = range[1];
        
        while (left < right) {
            const mid = Math.floor((left + right) / 2);
            const midWidth = this.measureWidth(fontFamily, mid);
            
            if (type === 'min') {
                const lowerWidth = this.measureWidth(fontFamily, mid - 5);
                const isAtMinimum = Math.abs(midWidth - lowerWidth) < 0.5;
                
                if (isAtMinimum) {
                    left = mid + 1;
                } else {
                    right = mid;
                }
            } else {
                const higherWidth = this.measureWidth(fontFamily, mid + 5);
                const isAtMaximum = Math.abs(midWidth - higherWidth) < 0.5;
                
                if (isAtMaximum) {
                    right = mid - 1;
                } else {
                    left = mid + 1;
                }
            }
        }
        
        const result = left;
        return result;
    }
    
    measureWidth(fontFamily, wdth) {
        const testEl = document.createElement('span');
        testEl.style.cssText = `
            position: absolute; top: -9999px; visibility: hidden;
            font-family: ${fontFamily};
            font-size: 100px;
            font-variation-settings: "wdth" ${wdth};
        `;
        testEl.textContent = 'W';
        document.body.appendChild(testEl);
        
        testEl.offsetHeight;
        
        const width = testEl.getBoundingClientRect().width;
        document.body.removeChild(testEl);
        return width;
    }
    
    getTransformOrigin(textAlign, direction = 'ltr') {
        const isRTL = direction === 'rtl';
        
        switch (textAlign) {
            case 'center':
            case '-webkit-center':
                return 'center';
                
            case 'right':
            case '-webkit-right':
                return 'right center';
                
            case 'left':
            case '-webkit-left':
                return 'left center';
                
            case 'start':
                return isRTL ? 'right center' : 'left center';
                
            case 'end':
                return isRTL ? 'left center' : 'right center';
                
            case 'justify':
            case 'justify-all':
                return isRTL ? 'right center' : 'left center';
                
            case 'inherit':
            case 'initial':
            case 'unset':
            case 'revert':
                return isRTL ? 'right center' : 'left center';
                
            default:
                return isRTL ? 'right center' : 'left center';
        }
    }
}

// ES Module export
export default CoolTextFit;